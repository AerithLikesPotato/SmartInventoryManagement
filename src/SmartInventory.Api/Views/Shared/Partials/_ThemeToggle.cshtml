@* Light/dark switch. State + label are kept in sync by js/modules/theme.js. *@
<button type="button" class="btn btn--icon theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark theme">
    <svg class="icon theme-toggle__moon" aria-hidden="true" focusable="false"><use href="#i-moon"></use></svg>
    <svg class="icon theme-toggle__sun" aria-hidden="true" focusable="false"><use href="#i-sun"></use></svg>
</button>
