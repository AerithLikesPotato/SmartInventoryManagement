@*
    Primary navigation. Items are filtered based on the user's role.
*@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    // Cashiers only see the Sales Counter; Admins see the whole store
    var nav = User.IsInRole("Admin")
        ? new[]
        {
            (Label: "Dashboard", Controller: "Dashboard", Action: "Index", Icon: "grid"),
            (Label: "Inventory", Controller: "Products", Action: "Index", Icon: "box"),
            (Label: "Sales (POS)", Controller: "Sales", Action: "Index", Icon: "layers")
        }
        : new[]
        {
            (Label: "Sales (POS)", Controller: "Sales", Action: "Index", Icon: "layers")
        };

    var userName = User.Identity?.Name ?? "Signed in";
    var initial = userName.Length > 0 ? char.ToUpperInvariant(userName[0]).ToString() : "?";
    var role = User.IsInRole("Admin") ? "Administrator" : "Cashier";
}

<div class="sidebar" id="app-sidebar" data-sidebar>
    <div class="sidebar__panel">
        <div class="sidebar__head">
            <a class="brand" asp-controller="@(User.IsInRole("Admin") ? "Dashboard" : "Sales")" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">
                    <svg class="icon"><use href="#i-box"></use></svg>
                </span>
                SmartInventory
            </a>
            <button type="button" class="btn btn--icon drawer-only" data-sidebar-close aria-label="Close navigation">
                <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"></use></svg>
            </button>
        </div>

        <nav class="sidebar__nav" aria-label="Main">
            <p class="sidebar__section" aria-hidden="true">Menu</p>
            @foreach (var item in nav)
            {
                var isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                <a class="nav-link"
                   asp-controller="@item.Controller"
                   asp-action="@item.Action"
                   aria-current="@(isActive ? "page" : null)">
                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-@item.Icon"></use></svg>
                    @item.Label
                </a>
            }
        </nav>

        <div class="sidebar__foot">
            <div class="user-chip">
                <span class="user-chip__avatar" aria-hidden="true">@initial</span>
                <div class="user-chip__text">
                    <p class="user-chip__name" title="@userName">@userName</p>
                    <p class="user-chip__role">@role</p>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn--block">
                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-log-out"></use></svg>
                    Sign out
                </button>
            </form>
        </div>
    </div>
</div>