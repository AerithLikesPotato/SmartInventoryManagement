@* Runs before first paint so there is no light->dark flash. Keep key in sync with js/modules/theme.js *@
<script>
    (function () {
        var theme = 'light';
        try {
            var saved = localStorage.getItem('si-theme');
            if (saved === 'dark' || saved === 'light') {
                theme = saved;
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                theme = 'dark';
            }
        } catch (e) { /* storage blocked: stay on light */ }
        document.documentElement.setAttribute('data-theme', theme);
    })();
</script>
