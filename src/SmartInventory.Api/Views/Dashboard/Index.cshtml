@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="page-header__text">
        <h1>Dashboard</h1>
        <p>Your stock health at a glance.</p>
    </div>
    <a class="btn btn--primary" asp-controller="Products" asp-action="Create">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"></use></svg>
        Add product
    </a>
</div>

<section class="grid" style="--grid-min: 13rem" aria-label="Key figures">
    <partial name="Partials/_StatCard" model='new StatCardViewModel("Products", Model.TotalProducts.ToString("N0"), "box")' />
    <partial name="Partials/_StatCard" model='new StatCardViewModel("Units in stock", Model.TotalUnits.ToString("N0"), "layers")' />
    <partial name="Partials/_StatCard" model='new StatCardViewModel("Inventory value", Model.InventoryValue.ToString("C0"), "coins", "success")' />
    <partial name="Partials/_StatCard" model='new StatCardViewModel("Need reordering", Model.LowStockCount.ToString("N0"), "trending-down", Model.LowStockCount > 0 ? "warning" : null)' />
</section>

<div class="dashboard-columns">
    <section class="card" aria-labelledby="attention-title">
        <div class="card__header">
            <h2 id="attention-title">Needs attention</h2>
            <a class="text-sm" asp-controller="Products" asp-action="Index" asp-route-filter="Low">View all</a>
        </div>

        @if (Model.NeedsAttention.Count == 0)
        {
            <div class="empty">
                <span class="empty__icon" aria-hidden="true"><svg class="icon"><use href="#i-check-circle"></use></svg></span>
                <h3>Everything is stocked</h3>
                <p>No product is at or below its reorder level.</p>
            </div>
        }
        else
        {
            <ul class="list">
                @foreach (var product in Model.NeedsAttention)
                {
                    <li class="list__item">
                        <div class="attention-item">
                            <div class="attention-item__top">
                                <div class="list__main">
                                    <p class="list__title">@product.Name</p>
                                    <p class="list__sub"><span class="mono">@product.Sku</span> · @product.CurrentStock.ToString("N0") left, reorder at @product.ReorderLevel.ToString("N0")</p>
                                </div>
                                <partial name="Partials/_StockBadge" model="product.Status" />
                            </div>
                            <partial name="Partials/_StockMeter" model="product" />
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card" aria-labelledby="alerts-title">
        <div class="card__header">
            <h2 id="alerts-title">Open alerts</h2>
        </div>

        @if (Model.OpenAlerts.Count == 0)
        {
            <div class="empty">
                <span class="empty__icon" aria-hidden="true"><svg class="icon"><use href="#i-check-circle"></use></svg></span>
                <h3>All clear</h3>
                <p>There are no unresolved alerts.</p>
            </div>
        }
        else
        {
            <ul class="list">
                @foreach (var alert in Model.OpenAlerts)
                {
                    var badgeClass = "badge badge--" + alert.Severity.Tone();
                    <li class="list__item">
                        <div class="list__main">
                            <p class="list__title">@alert.ProductName</p>
                            <p class="list__sub">@alert.Message</p>
                        </div>
                        <div class="list__aside">
                            <span class="@badgeClass">@alert.Severity.Label()</span>
                            <time class="list__sub" datetime="@alert.CreatedAtUtc.ToString("o")" data-localize>@alert.CreatedAtUtc.ToString("MMM d, HH:mm") UTC</time>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<section class="card" aria-labelledby="activity-title">
    <div class="card__header">
        <h2 id="activity-title">Recent activity</h2>
    </div>

    @if (Model.RecentActivity.Count == 0)
    {
        <div class="empty">
            <span class="empty__icon" aria-hidden="true"><svg class="icon"><use href="#i-layers"></use></svg></span>
            <h3>No stock movements yet</h3>
            <p>Stock in, out and adjustments will show up here.</p>
        </div>
    }
    else
    {
        <ul class="list">
            @foreach (var item in Model.RecentActivity)
            {
                <li class="list__item">
                    <div class="list__main">
                        <p class="list__title">@item.ProductName</p>
                        <p class="list__sub">
                            <span>@item.Type.Label()</span>
                            <span> · by <span class="mono" style="font-weight: 600">@item.Actor</span></span>
                            @if (!string.IsNullOrWhiteSpace(item.ReferenceNumber))
                            {
                                <span> · Ref @item.ReferenceNumber</span>
                            }
                        </p>
                    </div>
                    <div class="list__aside">
                        <span class="list__title tabular">@item.Type.Sign()@Math.Abs(item.Quantity).ToString("N0")</span>
                        <time class="list__sub" datetime="@item.TimestampUtc.ToString("o")" data-localize>@item.TimestampUtc.ToString("MMM d, HH:mm") UTC</time>
                    </div>
                </li>
            }
        </ul>
    }
</section>
